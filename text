class Login(QMainWindow, Ui_MainWindow_Login):
    def __init__(self):
        super().__init__()
        self.setupUi(self)
        self.db = Base()

        self.pushButton.clicked.connect(self.auth)

    def auth(self):
        try:
            login = self.lineEdit.text()
            password = self.lineEdit_2.text()

            if login == '' or password == '':
                return QMessageBox.information(self, 'Ошибка', 'Заполните все поля')

            result = self.db.select_user(login, password)

            if result is None:
                return QMessageBox.information(self, 'Ошибка', 'Не верный логин или пароль')

            id_user, id_role, fio_user = self.db.select_user(login, password)

            if id_role==1:
                QtWidgets.QMessageBox.information(self,'Уведомление','Успешный вход, Администратор')
                self.autorization(id_user, id_role, fio_user)
            if id_role==2:
                QtWidgets.QMessageBox.information(self,'Уведомление','Успешный вход, Клиент')
                self.autorization(id_user, id_role, fio_user)
            if id_role==3:
                QtWidgets.QMessageBox.information(self,'Уведомление','Успешный вход, Менеджер')
                self.autorization(id_user, id_role, fio_user)
        except Exception as e:
            print(e)

    def autorization(self,role,user,fio_user):
        try:
            self.window=Main(role,user,fio_user)
            self.window.show()
            self.close()
        except Exception as e:
            print(e)
