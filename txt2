create database shop;
use shop;

create table roles(
id int primary key auto_increment, 
name varchar(255));

create table users (
id int primary key auto_increment, 
login varchar(255),
password varchar(255),
id_role int,
foreign key (id_role) references roles(id),
name varchar(255),
l_name varchar(255),
surname varchar(255)
);

create table categories(
id int primary key auto_increment, 
name varchar(255));


create table factories (
id int primary key auto_increment, 
name varchar(255));

create table suppliers (
id int primary key auto_increment,
name varchar(255));

create table goods (
id int primary key auto_increment, 
photo varchar(255),
name varchar(255),
dscription varchar(255),
id_categ int,
foreign key (id_categ) references categories(id),
id_supplier int,
foreign key (id_supplier) references suppliers(id),
id_factory int,
foreign key (id_factory) references factories(id),
price decimal(8,2),
quantity_warehouse int,
discount int,
measur_unit varchar(255)
);

create table statuses (
id int primary key auto_increment, 
name varchar(255));

create table orders (
id int primary key auto_increment, 
articul varchar(255),
address_place varchar(255),
id_user int, 
foreign key (id_user) references users(id),
dt_order date default '2026-05-31',
dt_delivery date,
total_cost decimal(8,2),
id_status int,
foreign key (id_status) references statuses(id)
);

create table order_goods(
id int primary key auto_increment, 
id_order int,
foreign key (id_order) references orders(id),
id_good int, 
foreign key (id_good) references goods(id),
quantity int
);
