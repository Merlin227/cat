    def search(self,text,supplier,change_price):

        patern=f'%{text}%'
        params = [patern, patern]
        sql='''
        select
         product.id_product,product.product_name,product.description,category.name_category,
         manufacturer.name_manufacturer,supplier.name_supplier,product.price,product.unit,product.stock_quantity,
         product.discount_percent,product.image_path from product
         
        join category on product.id_category=category.id_category
        join manufacturer on product.id_manufacturer=manufacturer.id_manufacturer
        join supplier on product.id_supplier=supplier.id_supplier
        
        where (product.product_name like %s or product.description like %s)
        '''
        if supplier!=0:
            sql+=' and product.id_supplier = %s'
            params.append(supplier)

        if change_price=="По возрастанию":
            sql +=' order by product.price asc'
        if change_price=="По убыванию":
            sql += ' order by product.price desc'
        self.cursor.execute(sql,tuple(params))
        res = self.cursor.fetchall()
        print(res)
        print(params)
        return res
